{
  "name": "oar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src drydock sea-trial",
    "check": "npm run typecheck && npm run lint",
    "teeth": "npx --yes tsx scripts/config-form-teeth.ts",
    "check-demo-html": "npx --yes tsx scripts/check-demo-html-js.ts artifacts-local/create-agent-form-live.html",
    "embed-live": "npx --yes tsx scripts/embed-live-html.ts && npm run check-demo-html"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.6.3"
  }
}
