{
  "name": "@botiverse/oar-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @botiverse/oar build && pnpm --filter @botiverse/oar-cli build",
    "typecheck": "pnpm --filter @botiverse/oar typecheck && pnpm --filter @botiverse/oar-cli typecheck && tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings packages/oar/src packages/cli/src drydock sea-trial",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "oar": "pnpm run build && node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  }
}
