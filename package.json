{
  "name": "@botiverse/oar-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @botiverse/oar build && pnpm --filter @botiverse/oar-cli build",
    "typecheck": "pnpm --filter @botiverse/oar typecheck && pnpm --filter @botiverse/oar-cli typecheck && tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --ignore-pattern \"tests/community/**\" packages/oar/src packages/cli/src apps/arena experiments sea-trial tests vitest.config.ts",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run sea-trial",
    "oar": "pnpm run build && node packages/cli/dist/index.js",
    "arena": "tsx apps/arena/server.ts",
    "sea-trial": "tsx sea-trial/main.ts",
    "sea-trial:record": "tsx sea-trial/record.ts",
    "clean-install": "tsx tests/clean-install.ts"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.39.0",
    "@cursor/sdk": "1.0.37",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@types/node": "^26.2.0",
    "esbuild": "0.28.2",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "undici": "8.10.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
