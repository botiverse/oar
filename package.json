{
  "name": "oar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src drydock sea-trial",
    "check": "npm run typecheck && npm run lint",
    "teeth": "pnpm exec tsx scripts/config-form-teeth.ts",
    "check-demo-html": "pnpm exec tsx scripts/check-demo-html-js.ts artifacts-local/create-agent-form-live.html",
    "embed-live": "pnpm exec tsx scripts/embed-live-html.ts && pnpm run check-demo-html",
    "oar": "pnpm exec tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.6.3",
    "tsx": "^4.21.0"
  },
  "bin": {
    "oar": "dist/cli.js"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "packageManager": "pnpm@9.12.3"
}
