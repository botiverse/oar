{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@botiverse/oar": ["../../packages/oar/src/index.ts"],
      "@botiverse/oar/observe": ["../../packages/oar/src/observe/index.ts"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
