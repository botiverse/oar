{
  "name": "@botiverse/oar-cli",
  "version": "0.0.6",
  "description": "Command-line interface for observing agent runtimes with OAR",
  "type": "module",
  "bin": {
    "oar": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @botiverse/oar build && tsc --noEmit",
    "prepack": "pnpm --filter @botiverse/oar build && pnpm run build"
  },
  "dependencies": {
    "@botiverse/oar": "workspace:*",
    "commander": "^12.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/oar.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0"
}
