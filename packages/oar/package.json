{
  "name": "@botiverse/oar",
  "version": "0.15.2",
  "description": "A programming interface for all agent harnesses: provider-independent contracts for controlling and observing agent runtimes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./observe": {
      "types": "./dist/observe/index.d.ts",
      "import": "./dist/observe/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js"
    },
    "./brands": {
      "types": "./dist/brands.d.ts",
      "import": "./dist/brands.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./assets/brands/*": "./assets/brands/*"
  },
  "files": [
    "dist",
    "README.md",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/oar.git",
    "directory": "packages/oar"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@cursor/sdk": "1.0.35",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "cross-spawn": "^7.0.6",
    "undici": "8.10.2",
    "which": "^2.0.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/which": "^2.0.2"
  }
}
